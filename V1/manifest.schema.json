{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/javisr/yard-binaries/main/V1/manifest.schema.json",
  "title": "Yard download manifest V1",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "generatedAt",
    "packages"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "https": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "package": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "releases"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "service",
            "runtime",
            "tool",
            "extension",
            "web",
            "browser"
          ]
        },
        "providerURL": {
          "$ref": "#/$defs/https"
        },
        "releases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/release"
          }
        }
      }
    },
    "release": {
      "type": "object",
      "required": [
        "version",
        "published",
        "downloads"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$"
        },
        "published": {
          "type": "boolean"
        },
        "minimumMacOS": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+){0,2}$"
        },
        "license": {
          "type": "string"
        },
        "sourceURL": {
          "$ref": "#/$defs/https"
        },
        "downloads": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/download"
          }
        }
      }
    },
    "download": {
      "type": "object",
      "required": [
        "role",
        "url",
        "format"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "url": {
          "$ref": "#/$defs/https"
        },
        "format": {
          "enum": [
            "tar-gz",
            "zip",
            "binary",
            "phar",
            "php",
            "npm",
            "composer",
            "playwright"
          ]
        },
        "architecture": {
          "enum": [
            "arm64",
            "universal",
            "any"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "integrity": {
          "type": "string"
        },
        "stripComponents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      }
    }
  }
}
